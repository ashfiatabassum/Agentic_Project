# Copy to server/.env and fill in local values. Never commit server/.env.

# API server
PORT=4000
NODE_ENV=development

# Local MySQL 8 connection (MySQL80 Windows service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=testimonial_app
DB_PASSWORD=change-me
DB_NAME=testimonial_mvp

# Only behind a reverse proxy you control: "loopback" or a hop count such as 1 (never true).
# Leave unset for local development.
# TRUST_PROXY=
