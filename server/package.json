{
  "name": "testimonial-mvp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express + MySQL API for the Testimonial MVP",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:reset": "node --env-file-if-exists=.env db/migrate.js --reset",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "pretest": "node --env-file=.env.test db/migrate.js --reset",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.6"
  }
}
